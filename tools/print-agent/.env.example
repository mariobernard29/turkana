# Copia este archivo como .env y llena los valores. Ver README.md.

# Los mismos de la app (Supabase → Settings → API).
# Va la llave PÚBLICA (anon), no la de servicio: esta PC está en el mostrador.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Usuario de Supabase creado sólo para la impresora, con rol de personal
# (Admin → Ajustes → Usuarios). No uses la cuenta de una persona.
AGENT_EMAIL=impresora@turkanajewerly.com
AGENT_PASSWORD=

# El id de la fila de la tabla `printers` que atiende este agente
# (Admin → Ajustes → Impresoras lo muestra).
PRINTER_ID=

# La impresora en la red. Ponle IP fija o reserva de DHCP en el router:
# si un día cambia de IP, deja de imprimir.
PRINTER_HOST=192.168.1.100
PRINTER_PORT=9100
